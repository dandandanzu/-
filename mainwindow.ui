         <string notr="true">QPlainTextEdit {
    background-color: #004B23;      /* 深墨绿色，柔和一点 */
    color: #FFEA00;                 /* 亮黄色，带点暖意 */
    border: 2px solid #A9A9A9;     /* 中灰色边框 */
    border-radius: 6px;             /* 圆角 */
    padding: 6px;                   /* 内边距 */
    font-weight: bold;              /* 粗体字体 */
    font-family: &quot;Consolas&quot;, &quot;Courier New&quot;, monospace; /* 等宽字体 */
    font-size: 14px;                /* 字号适中 */
}

QPlainTextEdit:hover {
    border-color: #FFD700;          /* 鼠标悬停时边框金黄色 */
}
</string>
