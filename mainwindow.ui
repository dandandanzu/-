  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background-color: #E8F5E9;        /* 浅绿色背景 */
    color: #000000;                   /* 黑色字体（新宋体适合深色字） */
    font-family: &quot;NSimSun&quot;, &quot;SimSun&quot;, serif;  /* 新宋体优先 */
    font-size: 14px;
}

QMenuBar {
    background-color: #A5D6A7;        /* 菜单栏浅绿 */
    color: #000000;
}

QMenuBar::item:selected {
    background-color: #81C784;        /* 菜单项悬停稍深的浅绿 */
}

QStatusBar {
    background-color: #A5D6A7;
    color: #000000;
    border-top: 1px solid #81C784;
}

QToolBar {
    background-color: #A5D6A7;
    border: none;
}

QPushButton {
    background-color: #81C784;
    color: #000000;
    border: 1px solid #66BB6A;
    border-radius: 5px;
    padding: 5px 12px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #66BB6A;
}

QPushButton:pressed {
    background-color: #00BFFF;
}

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #E8F5E9;        /* 输入框浅色背景 */
    color: #000000;
    border: 1px solid #81C784;
    border-radius: 4px;
    padding: 4px;
    font-family: &quot;NSimSun&quot;, &quot;SimSun&quot;, serif;
}

QHeaderView::section {
    background-color: #81C784;
    color: #000000;
    padding: 4px;
    border: 1px solid #66BB6A;
}

QTableView {
    background-color: #E8F5E9;       /* 表格浅色背景 */
    color: #000000;
    gridline-color: #81C784;
}

QScrollBar:vertical {
    background-color: #A5D6A7;
    width: 14px;
    margin: 15px 3px 15px 3px;
    border: 1px solid #81C784;
    border-radius: 7px;
}

QScrollBar::handle:vertical {
    background-color: #81C784;
    min-height: 20px;
    border-radius: 7px;
}

QScrollBar::handle:vertical:hover {
    background-color: #66BB6A;
}

QGroupBox {
    background-color: #E8F5E9;       /* 浅绿背景 */
    color: #000000;                  /* 黑色字体 */
    border: 2px solid #81C784;
    border-radius: 5px;
    margin-top: 10px;
    font-weight: bold;
    padding: 6px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    padding: 0 3px;
    color: #000000;                  /* 标题黑色 */
}

QComboBox {
    background-color: #E8F5E9;       /* 浅绿背景 */
    color: #000000;
    border: 1px solid #81C784;
    border-radius: 4px;
    padding: 4px;
}

QComboBox QAbstractItemView {
    background-color: #F0FFF0;       /* 下拉框更浅绿 */
    color: #000000;
    selection-background-color: #C8E6C9; /* 选中项浅绿 */
    selection-color: #000000;
}

QComboBox:hover {
    border: 1px solid #66BB6A;
}

QComboBox:focus {
    border: 2px solid #4CAF50;
}</string>
